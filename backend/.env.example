# Cloudflare Workers AI (for vision analysis)
CLOUDFARE_API=your_cloudflare_api_token
CLOUDFARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFARE_MODEL=@cf/llama-3.2-90b-vision-instruct

# Frontend URL for CORS (required for production)
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Optional: API Key for protecting the analyze endpoint
# If not set, the endpoint will be public (not recommended for production)
API_KEY=your_secure_random_string
